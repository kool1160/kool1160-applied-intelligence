{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Applied Intelligence Permissions Schema",
  "type": "object",
  "required": ["roles"],
  "properties": {
    "roles": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "scope"],
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "scope": {
            "type": "array",
            "items": { "type": "string" }
          },
          "canView": {
            "type": "array",
            "items": { "type": "string" }
          },
          "canEdit": {
            "type": "array",
            "items": { "type": "string" }
          },
          "canRoute": {
            "type": "array",
            "items": { "type": "string" }
          },
          "canBroadcast": {
            "type": "boolean" }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": false
}
