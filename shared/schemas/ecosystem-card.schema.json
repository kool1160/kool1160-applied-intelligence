{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Applied Intelligence Ecosystem Card Schema",
  "type": "object",
  "required": ["id", "name", "tagline", "role", "status"],
  "properties": {
    "id": { "type": "string" },
    "name": { "type": "string" },
    "tagline": { "type": "string" },
    "role": { "type": "string" },
    "status": { "type": "string" },
    "principle": { "type": "string" },
    "category": { "type": "string" },
    "highlights": {
      "type": "array",
      "items": { "type": "string" }
    }
  },
  "additionalProperties": true
}
